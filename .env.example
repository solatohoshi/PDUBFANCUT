# Database
DATABASE_URL=postgresql://pwhl:pwhl@localhost:5432/pdubfancut

# Redis
REDIS_URL=redis://localhost:6379

# Cloudflare R2  (free tier: 10 GB/month, zero egress fees)
# Dashboard → R2 → your bucket → Settings to find Account ID
# Dashboard → R2 → Manage API Tokens to create an API token
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=pdubfancut-uploads

# Server
PORT=3001
FRONTEND_URL=http://localhost:5173

# Clerk authentication (backend)
# Get your secret key at clerk.com → Your Application → API Keys
CLERK_SECRET_KEY=sk_test_your_key_here

# Optional: PEM public key for offline JWT verification (no network call to Clerk).
# Get from Clerk Dashboard → API Keys → JWT Verification Key.
# Use this when the backend is on a network that can't reach api.clerk.com.
# CLERK_JWT_KEY=-----BEGIN PUBLIC KEY-----\n...

# Set to true to skip Clerk token verification entirely (dev only).
# DEV_BYPASS_AUTH=true

# Resend email (for clips-ready notifications)
RESEND_API_KEY=re_your_key_here
# Verified sender domain (leave blank to use onboarding@resend.dev in dev)
RESEND_FROM_EMAIL=

# Anthropic — Claude video analysis (get from console.anthropic.com → API Keys)
ANTHROPIC_API_KEY=sk-ant-your_key_here

# FFmpeg — only needed if ffmpeg/ffprobe are not on your system PATH.
# On Windows via winget the install is at:
# %LOCALAPPDATA%\Microsoft\WinGet\Packages\Gyan.FFmpeg_...\ffmpeg-x.x.x-full_build\bin\ffmpeg.exe
# FFMPEG_PATH=C:\path\to\ffmpeg.exe
# FFPROBE_PATH=C:\path\to\ffprobe.exe
