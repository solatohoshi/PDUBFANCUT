{
  "name": "@pdubfancut/backend",
  "version": "0.1.0",
  "scripts": {
    "dev": "dotenv -e ../../.env -- tsx watch src/index.ts",
    "build": "tsc",
    "start": "dotenv -e ../../.env -- node dist/index.js",
    "migrate": "dotenv -e ../../.env -- tsx src/db/migrate.ts",
    "worker": "dotenv -e ../../.env -- tsx src/jobs/worker.ts",
    "test": "npm run test:security && npm run test:eval && npm run test:ffmpeg",
    "test:legacy:phase1": "dotenv -e ../../.env -- tsx src/test-phase1.ts",
    "test:phase2": "dotenv -e ../../.env -- tsx src/test-phase2.ts",
    "test:phase3": "dotenv -e ../../.env -- tsx src/test-phase3.ts",
    "test:phase4": "dotenv -e ../../.env -- tsx src/test-phase4.ts",
    "eval": "dotenv -e ../../.env -- tsx src/eval/run.ts",
    "eval:export": "dotenv -e ../../.env -- tsx src/eval/exportPredictions.ts",
    "test:eval": "tsx src/eval/evaluate.test.ts",
    "test:security": "tsx src/lib/capabilityTokens.test.ts",
    "test:ffmpeg": "tsx src/lib/ffmpeg.test.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.110.0",
    "@aws-sdk/client-s3": "^3.600.0",
    "@aws-sdk/s3-request-presigner": "^3.1079.0",
    "@clerk/backend": "^3.10.0",
    "@fastify/cors": "^11.3.0",
    "@fastify/rate-limit": "^11.2.0",
    "@neondatabase/serverless": "^1.1.0",
    "@tus/file-store": "^1.5.1",
    "@tus/s3-store": "^1.4.0",
    "@tus/server": "^1.4.0",
    "bullmq": "^5.12.0",
    "dotenv": "^16.4.5",
    "fastify": "^5.12.1",
    "fastify-plugin": "^6.0.0",
    "ioredis": "^5.4.1",
    "pg": "^8.12.0",
    "resend": "^6.17.0",
    "ws": "^8.21.0"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "@types/pg": "^8.6.0",
    "@types/ws": "^8.18.1",
    "dotenv-cli": "^11.0.0",
    "tsx": "^4.15.0",
    "typescript": "^5.4.5"
  }
}
